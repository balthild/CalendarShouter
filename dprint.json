{
	"includes": [
		".vscode/*.json",
		".swift-format",
		"dprint.json",
		"Sources/**/*.{swift,xcstrings}",
		"Tests/**/*.swift",
		"Plugins/**/*.swift",
		"Tools/**/*.swift",
		"Package.swift",
	],
	"excludes": [
		".build",
	],
	"useTabs": true,
	"indentWidth": 2,
	"lineWidth": 100,
	"json": {
		"associations": ["*.{json,jsonc,xcstrings}", ".swift-format"],
		"trailingCommas": "jsonc",
		"jsonTrailingCommaFiles": [
			"dprint.json",
			".vscode/extensions.json",
			".vscode/launch.json",
			".vscode/settings.json",
		],
	},
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "swift format {{file_path}}",
				"exts": ["swift"],
				"cacheKeyFiles": [".swift-format"],
				"stdin": false,
			},
		],
	},
	"plugins": [
		"npm:@dprint/json@0.24.0",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
	],
}
