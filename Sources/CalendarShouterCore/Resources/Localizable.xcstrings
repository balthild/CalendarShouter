		},
		"loginItemAutomationMessage": {
			"extractionState": "manual",
			"localizations": {
				"en": {
					"stringUnit": {
						"state": "translated",
						"value": "CalendarShouter needs permission to control System Events before it can add itself to your login items. Grant it in System Settings → Privacy & Security → Automation."
					}
				},
				"zh-Hans": {
					"stringUnit": {
						"state": "translated",
						"value": "日历提醒需要获得控制“系统事件”的权限，才能把自己加入登录项。请在“系统设置 → 隐私与安全性 → 自动化”中允许。"
					}
				}
			}
		},
