		"loginItemApprovalMessage": {
			"extractionState": "manual",
			"localizations": {
				"en": {
					"stringUnit": {
						"state": "translated",
						"value": "CalendarShouter is set to launch at login, but macOS needs you to approve it in System Settings first."
					}
				},
				"zh-Hans": {
					"stringUnit": {
						"state": "translated",
						"value": "日历提醒已设为登录时启动，但需要你先在系统设置中批准。"
					}
				}
			}
		},
		"loginItemApprovalTitle": {
			"extractionState": "manual",
